
{
  "name": "scratch-user-info",
  "compatibility_date": "2026-10-25",
  "main": "src/worker.js",

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,

    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },

    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },

  "cache": {
    "enabled": true
  },

  "previews": {
    "observability": {
      "enabled": true,
      "head_sampling_rate": 1,

      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "invocation_logs": true,
        "persist": true
      },

      "traces": {
        "enabled": true,
        "persist": true,
        "head_sampling_rate": 1
      },

      "issue_detection": {
        "enabled": true
      }
    }
  }
}
